{
  "name": "lumen",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:api": "tsx watch server/src/index.ts",
    "server": "tsx server/src/index.ts",
    "dev": "concurrently -n web,api -c blue,green \"ng serve\" \"npm run start:api\"",
    "build": "prisma generate && ng build && npm run build:server",
    "build:vercel": "prisma generate && npm run build:server && rm -rf api/_server && cp -r server/dist api/_server && ng build && cp dist/lumen/browser/index.html dist/lumen/browser/404.html",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "ng build",
    "watch": "ng build --watch --configuration development",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:setup": "prisma db push && prisma db seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@angular/animations": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@prisma/client": "^6.4.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.10.0",
    "@vercel/node": "^5.0.0",
    "concurrently": "^9.1.0",
    "prisma": "^6.4.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0",
    "vercel": "^41.0.0"
  }
}
