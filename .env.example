# ── Node.js server ──────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database (SQLite local; use Postgres URL on Vercel) ─────
DATABASE_URL="file:./prisma/dev.db"

# ── Admin CMS ───────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@lumen.health
ADMIN_PASSWORD=changeme123

# ── Beehiiv Newsletter ──────────────────────────────────────
BEEHIIV_API_KEY=your_beehiiv_api_key
BEEHIIV_PUB_ID=your_publication_id

# ── Contact (Resend) ──────────────────────────────────────
RESEND_API_KEY=re_...
CONTACT_FROM_EMAIL=hello@lumen.health
CONTACT_TO_EMAIL=team@lumen.health

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200
